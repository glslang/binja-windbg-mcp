  {
    "name": "get_code",
    "description": "Get bounded function code with source addresses and the actual representation.",
    "input_schema": {
      "type": "object",
      "properties": {
        "binary_id": {
          "title": "Binary Id",
          "type": "string"
        },
        "rva": {
          "title": "Rva",
          "type": "string"
        },
        "representation": {
          "default": "auto",
          "enum": [
            "auto",
            "disassembly",
            "llil",
            "mlil",
            "hlil"
          ],
          "title": "Representation",
          "type": "string"
        },
        "limit": {
          "default": 200,
          "title": "Limit",
          "type": "integer"
