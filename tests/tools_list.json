    "output_schema": {
      "$defs": {
        "CodeLine": {
          "properties": {
            "address": {
              "title": "Address",
              "type": "string"
            },
            "rva": {
              "title": "Rva",
              "type": "string"
            },
            "text": {
              "maxLength": 4096,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "address",
            "rva",
            "text"
          ],
          "title": "CodeLine",
          "type": "object"
        }
      },
      "properties": {
        "status": {
          "default": "success",
          "enum": [
            "success",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "representation": {
          "anyOf": [
            {
              "enum": [
                "disassembly",
                "llil",
                "mlil",
                "hlil"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Representation"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/CodeLine"
          },
          "maxItems": 1000,
          "title": "Lines",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "title": "CodeResult",
      "type": "object"
    },
    "annotations": {
      "read_only_hint": true,
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false
    }
  },
