[
  {
    "name": "add_evidence",
    "description": "Append an undoable provenance record. Never include tokens or connection strings.",
    "input_schema": {
      "type": "object",
      "$defs": {
        "Coordinate": {
          "additionalProperties": false,
          "properties": {
            "module": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Module",
              "type": "string"
            },
            "image_name": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Image Name",
              "type": "string"
            },
            "identity": {
              "$ref": "#/$defs/Identity"
            },
            "rva": {
              "maxLength": 18,
              "pattern": "^0x[0-9a-f]+$",
              "title": "Rva",
              "type": "string"
            }
          },
          "required": [
            "module",
            "image_name",
            "identity",
            "rva"
          ],
          "title": "Coordinate",
          "type": "object"
        },
        "Evidence": {
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "maxLength": 256,
              "title": "Session Id",
              "type": "string"
            },
            "profile": {
              "maxLength": 256,
              "title": "Profile",
              "type": "string"
            },
            "runtime_address": {
              "pattern": "^0x[0-9a-f]{16}$",
              "title": "Runtime Address",
              "type": "string"
            },
            "thread": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Thread"
            },
            "processor": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Processor"
            },
            "note": {
              "maxLength": 8192,
              "title": "Note",
              "type": "string"
            }
          },
          "required": [
            "session_id",
            "profile",
            "runtime_address",
            "note"
          ],
          "title": "Evidence",
          "type": "object"
        },
        "Identity": {
          "additionalProperties": false,
          "properties": {
            "timestamp": {
              "maximum": 4294967295,
              "minimum": 0,
              "title": "Timestamp",
              "type": "integer"
            },
            "size": {
              "exclusiveMinimum": 0,
              "maximum": 4294967295,
              "title": "Size",
              "type": "integer"
            },
            "pdb": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Pdb"
            }
          },
          "required": [
            "timestamp",
            "size"
          ],
          "title": "Identity",
          "type": "object"
        }
      },
      "properties": {
        "binary_id": {
          "title": "Binary Id",
          "type": "string"
        },
        "coordinate": {
          "$ref": "#/$defs/Coordinate"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "binary_id",
        "coordinate",
        "evidence"
      ],
      "title": "add_evidenceArguments"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "add_evidenceDictOutput",
      "type": "object"
    },
    "annotations": {
      "read_only_hint": false,
      "destructive_hint": false,
      "idempotent_hint": false,
      "open_world_hint": false
    }
  },
