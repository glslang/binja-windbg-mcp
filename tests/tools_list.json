      "additionalProperties": true,
      "title": "similarity_resultsDictOutput",
      "type": "object"
    },
    "annotations": {
      "read_only_hint": true,
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false
    }
  },
