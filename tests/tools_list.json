  {
    "name": "similarity_results",
    "description": "Page terminal matches (scores 0\u2013255) or unmatched functions; incomplete coverage is explicit.",
    "input_schema": {
      "type": "object",
      "properties": {
        "comparison_id": {
          "title": "Comparison Id",
          "type": "string"
        },
        "side": {
          "default": "target",
          "enum": [
            "reference",
            "target"
          ],
          "title": "Side",
          "type": "string"
        },
        "kind": {
          "default": "matches",
          "enum": [
            "matches",
            "unmatched"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "Google BinDiff",
                "WARP"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "min_similarity": {
          "default": 0,
          "title": "Min Similarity",
          "type": "integer"
        },
        "min_confidence": {
          "default": 0,
          "title": "Min Confidence",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 100,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "comparison_id"
      ],
      "title": "similarity_resultsArguments"
    },
